{
  "name": "fieldops-360",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "server": "node server/index.mjs",
    "start": "node server/index.mjs",
    "build": "vite build",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "playwright test",
    "verify": "npm test && npm run build",
    "erp": "node server/erp.mjs",
    "check:artifacts": "python3 scripts/validate-artifacts.py"
  },
  "dependencies": {
    "lucide-react": "0.468.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@vitejs/plugin-react": "5.1.1",
    "prettier": "3.9.10",
    "vite": "7.3.7"
  }
}
