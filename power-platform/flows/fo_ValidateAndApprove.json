{
  "name": "fo_ValidateAndApprove",
  "description": "SOURCE TEMPLATE: connector binding and environment validation required",
  "properties": {
    "connectionReferences": {
      "shared_commondataserviceforapps": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "fo_Dataverse"
        },
        "api": {
          "name": "shared_commondataserviceforapps"
        }
      },
      "shared_approvals": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "fo_Approvals"
        },
        "api": {
          "name": "shared_approvals"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "fo_ApproverEmail": {
          "defaultValue": "",
          "type": "String"
        },
        "fo_ErpEndpoint": {
          "defaultValue": "",
          "type": "String"
        },
        "fo_ErpKey": {
          "type": "SecureString"
        }
      },
      "triggers": {
        "Delivery_pending": {
          "type": "OpenApiConnectionWebhook",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "SubscribeWebhookTrigger",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "subscriptionRequest/message": 3,
              "subscriptionRequest/entityname": "fo_delivery",
              "subscriptionRequest/scope": 4,
              "subscriptionRequest/filterexpression": "fo_status eq 'pending'"
            }
          },
          "conditions": [],
          "runtimeConfiguration": {
            "concurrency": {
              "runs": 1
            }
          }
        }
      },
      "actions": {
        "Validate": {
          "type": "If",
          "expression": {
            "and": [
              {
                "greater": [
                  "@triggerOutputs()?['body/fo_quantity']",
                  0
                ]
              },
              {
                "greater": [
                  "@triggerOutputs()?['body/fo_expected']",
                  0
                ]
              },
              {
                "not": {
                  "equals": [
                    "@parameters('fo_ApproverEmail')",
                    ""
                  ]
                }
              }
            ]
          },
          "actions": {
            "Approval": {
              "type": "OpenApiConnectionWebhook",
              "inputs": {
                "host": {
                  "connectionName": "shared_approvals",
                  "operationId": "StartAndWaitForAnApproval",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_approvals"
                },
                "parameters": {
                  "approvalType": "Basic",
                  "WebhookApprovalCreationInput/title": "@concat('FieldOps levering ',triggerOutputs()?['body/fo_reference'])",
                  "WebhookApprovalCreationInput/assignedTo": "@parameters('fo_ApproverEmail')",
                  "WebhookApprovalCreationInput/details": "@concat('Controleer origineel, hoeveelheid en afwijking: ',triggerOutputs()?['body/fo_note'])",
                  "WebhookApprovalCreationInput/enableNotifications": false,
                  "WebhookApprovalCreationInput/enableReassignment": false
                }
              },
              "limit": {
                "timeout": "P2D"
              },
              "runAfter": {}
            },
            "Decision": {
              "type": "If",
              "expression": {
                "equals": [
                  "@outputs('Approval')?['body/outcome']",
                  "Approve"
                ]
              },
              "actions": {
                "Approve_row": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_commondataserviceforapps",
                      "operationId": "UpdateRecord",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                    },
                    "parameters": {
                      "entityName": "fo_deliveries",
                      "recordId": "@triggerOutputs()?['body/fo_deliveryid']",
                      "item/fo_status": "approved"
                    }
                  },
                  "runAfter": {}
                },
                "Queue_ERP": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_commondataserviceforapps",
                      "operationId": "CreateRecord",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                    },
                    "parameters": {
                      "entityName": "fo_integrationjobs",
                      "item/fo_name": "@triggerOutputs()?['body/fo_reference']",
                      "item/fo_state": "queued",
                      "item/fo_idempotencykey": "@triggerOutputs()?['body/fo_deliveryid']",
                      "item/fo_deliveryid@odata.bind": "@concat('/fo_deliveries(',triggerOutputs()?['body/fo_deliveryid'],')')"
                    }
                  },
                  "runAfter": {
                    "Approve_row": [
                      "Succeeded"
                    ]
                  }
                }
              },
              "else": {
                "actions": {
                  "Reject_row": {
                    "type": "OpenApiConnection",
                    "inputs": {
                      "host": {
                        "connectionName": "shared_commondataserviceforapps",
                        "operationId": "UpdateRecord",
                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                      },
                      "parameters": {
                        "entityName": "fo_deliveries",
                        "recordId": "@triggerOutputs()?['body/fo_deliveryid']",
                        "item/fo_status": "rejected",
                        "item/fo_note": "@string(outputs('Approval')?['body/responses'])"
                      }
                    },
                    "runAfter": {}
                  }
                }
              },
              "runAfter": {
                "Approval": [
                  "Succeeded"
                ]
              }
            }
          },
          "else": {
            "actions": {
              "Invalid": {
                "type": "OpenApiConnection",
                "inputs": {
                  "host": {
                    "connectionName": "shared_commondataserviceforapps",
                    "operationId": "CreateRecord",
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                  },
                  "parameters": {
                    "entityName": "fo_auditevents",
                    "item/fo_name": "Validatie mislukt",
                    "item/fo_event": "validation_error",
                    "item/fo_detail": "@triggerOutputs()?['body/fo_reference']"
                  }
                },
                "runAfter": {}
              }
            }
          },
          "runAfter": {}
        },
        "Approval_timeout": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "CreateRecord",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "fo_auditevents",
              "item/fo_name": "Controleer goedkeuring",
              "item/fo_event": "approval_flow_failed"
            }
          },
          "runAfter": {
            "Validate": [
              "Failed",
              "TimedOut"
            ]
          }
        }
      }
    }
  }
}