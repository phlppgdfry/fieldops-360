{
  "properties": {
    "connectionReferences": {
      "shared_commondataserviceforapps": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "fo_dataverse"
        },
        "api": {
          "name": "shared_commondataserviceforapps"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        }
      },
      "triggers": {
        "On_failed_job": {
          "type": "OpenApiConnectionWebhook",
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "SubscribeWebhookTrigger"
            },
            "parameters": {
              "subscriptionRequest/message": 4,
              "subscriptionRequest/entityname": "fo_integrationjob",
              "subscriptionRequest/scope": 4,
              "subscriptionRequest/filterexpression": "fo_state eq 'dead'",
              "subscriptionRequest/filteringattributes": "fo_state"
            },
            "authentication": "@parameters('$authentication')"
          },
          "runtimeConfiguration": {
            "concurrency": {
              "runs": 1
            }
          }
        }
      },
      "actions": {
        "List_dead": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "ListRecords"
            },
            "parameters": {
              "entityName": "fo_integrationjobs",
              "$filter": "fo_state eq 'dead'",
              "$top": 100
            },
            "authentication": "@parameters('$authentication')"
          },
          "runAfter": {}
        },
        "Each": {
          "type": "Foreach",
          "foreach": "@outputs('List_dead')?['body/value']",
          "actions": {
            "Alert": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "CreateRecord"
                },
                "parameters": {
                  "entityName": "fo_auditevents",
                  "item/fo_name": "ERP-foutmelding",
                  "item/fo_event": "integration_error",
                  "item/fo_detail": "@items('Each')?['fo_error']",
                  "item/fo_deliveryid@odata.bind": "@concat('/fo_deliveries(',items('Each')?['_fo_deliveryid_value'],')')"
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {}
            },
            "Notified": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "UpdateRecord"
                },
                "parameters": {
                  "entityName": "fo_integrationjobs",
                  "recordId": "@items('Each')?['fo_integrationjobid']",
                  "item/fo_state": "dead_notified"
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {
                "Alert": [
                  "Succeeded"
                ]
              }
            }
          },
          "runAfter": {
            "List_dead": [
              "Succeeded"
            ]
          }
        }
      }
    },
    "templateName": null
  },
  "schemaVersion": "1.0.0.0"
}